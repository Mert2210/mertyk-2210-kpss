# Firebase Admin SDK (JSON formatýnda Service Account Key string olarak girilmeli)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"..."}

# Web Push Notifications (Web Uygulamasý Bildirimleri için GEREKLÝ)
# Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates altýndan alýn.
FIREBASE_VAPID_PUBLIC_KEY=B..._sizin_vapid_key_iniz...

# Firebase Client Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Supabase (Görsel Depolama için)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Diðer Ayarlar
PORT=3000
ALLOWED_ORIGIN=https://www.gazililer.com.tr
ADMIN_EMAILS=ornek@admin.com,diger@admin.com
GEMINI_API_KEY=
METRICS_SECRET=
